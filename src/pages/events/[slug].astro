---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const events = await Astro.glob('../../content/events/*.md');
  
  return events.map((event) => {
    // .url statt .file verwenden!
    const parts = event.url.split('/');
    const fileName = parts[parts.length - 1];
    const slug = fileName.replace('.md', '');
    
    return {
      params: { slug: slug },
      props: { event: event.frontmatter }
    };
  });
}

const { event } = Astro.props;
---
<Layout title={event.title}>
  <div style="width: 100%; height: 60vh; margin-top: 100px; overflow: hidden;">
    <img src={event.image} alt={event.title} style="width: 100%; height: 100%; object-fit: cover;">
  </div>

  <div style="max-width: 800px; margin: 60px auto; padding: 0 40px;">
    <p style="color: #b8945f; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 20px; text-align: center;">
      {event.date}
    </p>
    <h1 style="font-size: 48px; margin-bottom: 40px; text-align: center;">{event.title}</h1>
    
    <div style="font-size: 16px; line-height: 1.8; color: #444; text-align: justify;">
      {event.body}
    </div>

    {event.galerie && (
      <div style="margin-top: 80px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;">
        {event.galerie.map((foto) => (
          <img src={foto.image} alt="Impression" style="width: 100%; height: auto; border-radius: 4px;">
        ))}
      </div>
    )}
  </div>
</Layout>
