---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const events = await Astro.glob('../../content/events/*.md');
  
  return events.map((event) => {
    const slug = event.url.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { event: event.frontmatter, content: event.Content }
    };
  });
}

const { event } = Astro.props;
---
<Layout title={event.title}>
  <div style="width: 100%; height: 60vh; margin-top: 100px; overflow: hidden;">
    <img src={event.image} alt={event.title} style="width: 100%; height: 100%; object-fit: cover;">
  </div>

  <div style="max-width: 800px; margin: 60px auto; padding: 0 40px;">
    <p style="color: #b8945f; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 20px; text-align: center;">{new Date(event.date).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}</p>
    <h1 style="font-size: 48px; margin-bottom: 40px; text-align: center;">{event.title}</h1>
    <div style="font-size: 16px; line-height: 1.8; color: #444; text-align: justify;">
      <slot />
    </div>
  </div>
</Layout>
