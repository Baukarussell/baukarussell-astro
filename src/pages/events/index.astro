---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Events">
  <div style="padding: 200px 40px 100px; text-align: center; background: #1a1a1a; color: white;">
    <h1 style="font-size: 64px;">Unsere Events</h1>
    <p style="color: #d4b483; letter-spacing: 0.4em; text-transform: uppercase; font-size: 12px; margin-top: 15px;">Begegnung. Atmosphäre. Austausch.</p>
  </div>
  
  <div style="max-width: 1200px; margin: 0 auto; padding: 80px 40px;">
    <p style="text-align: center; color: #666;">Hier erscheinen in Kürze unsere vergangenen Events.</p>
    <!-- Hier fügen wir später die dynamische Liste ein, sobald das CMS läuft -->
  </div>
</Layout>
