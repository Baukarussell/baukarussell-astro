---
import Layout from '../../layouts/Layout.astro';

const allEvents = await Astro.glob('../../content/events/*.md');
const events = allEvents.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---
<Layout title="Events">
  <div style="padding: 200px 40px 100px; text-align: center; background: #1a1a1a; color: white;">
    <h1 style="font-size: 64px;">Unsere Events</h1>
    <p style="color: #d4b483; letter-spacing: 0.4em; text-transform: uppercase; font-size: 12px; margin-top: 15px;">Begegnung. Atmosphäre. Austausch.</p>
  </div>
  
  <div style="max-width: 1200px; margin: 0 auto; padding: 80px 40px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px;">
    {events.map((event) => {
      const slug = event.frontmatter.title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
      return (
        <a href={`/events/${slug}`} style="text-decoration: none; color: inherit; background: white; border: 1px solid #eee; display: block;">
          <div style="height: 300px; background: #ddd; overflow: hidden;">
            <img src={event.frontmatter.image} alt={event.frontmatter.title} style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="padding: 30px;">
            <p style="color: #b8945f; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 10px;">{new Date(event.frontmatter.date).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}</p>
            <h3 style="font-size: 28px; margin-bottom: 15px;">{event.frontmatter.title}</h3>
            <span style="color: #1a1a1a; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: bold; border-bottom: 1px solid #b8945f; padding-bottom: 5px;">Mehr erfahren →</span>
          </div>
        </a>
      );
    })}
  </div>
</Layout>
