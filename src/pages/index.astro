---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Networking à la carte">
  <section style="padding: 200px 40px 100px; text-align: center;">
    <h1 style="font-size: 48px; margin-bottom: 20px;">Herzlich Willkommen beim Baukarussell</h1>
    <p style="color: #666;">Wir bauen gerade unsere neue Webseite auf. Schauen Sie bald wieder vorbei!</p>
    
    <div id="about" style="margin-top: 100px; padding: 50px; background: white; text-align: left;">
      <h2>Über uns</h2>
      <p>Dieser Bereich wird in Kürze mit Inhalten gefüllt.</p>
    </div>
    
    <div style="margin-top: 50px;">
      <a href="/events" style="display: inline-block; padding: 15px 30px; background: #1a1a1a; color: white; text-decoration: none; text-transform: uppercase; letter-spacing: 0.2em; font-size: 12px;">Zu den Events →</a>
    </div>
  </section>
</Layout>
